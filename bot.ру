def get_user(uid):
    r = c.execute('''SELECT werx, diamonds, werk, rubins, stars, prestige, souls,
                     love_points, love_level, last_daily, xp, level, sytana_wins,
                     boss_wins, crystals, energy FROM users WHERE user_id=?''', (uid,)).fetchone()
    if r:
        return r
    c.execute('INSERT INTO users(user_id, werx) VALUES(?,?)', (uid, 1000))
    conn.commit()
    return (1000, 0, 0, 0, 0, 1, 0, 0, 0, None, 0, 1, 0, 0, 0, 100)

def u(uid, a, col):
    c.execute(f'UPDATE users SET {col} = {col} + ? WHERE user_id = ?', (a, uid))
    conn.commit()

def uw(uid, a): u(uid, a, 'werx')
def ud(uid, a): u(uid, a, 'diamonds')
def uk(uid, a): u(uid, a, 'werk')
def us(uid, a): u(uid, a, 'stars')
def usl(uid, a): u(uid, a, 'souls')
def up(uid, a): u(uid, a, 'prestige')
def ux(uid, a): u(uid, a, 'xp')
def ue(uid, a): u(uid, a, 'energy')
def uc(uid, a): u(uid, a, 'crystals')
def usw(uid, a): u(uid, a, 'sytana_wins')
def ubw(uid, a): u(uid, a, 'boss_wins')

def ul(uid, a):
    c.execute('UPDATE users SET love_points = love_points + ? WHERE user_id = ?', (a, uid))
    conn.commit()
    p, l = c.execute('SELECT love_points, love_level FROM users WHERE user_id=?', (uid,)).fetchone()
    nl = p // 200
    if nl > l:
        c.execute('UPDATE users SET love_level = ? WHERE user_id = ?', (nl, uid))
        conn.commit()
        return True, nl
    return False, l

def add_log(uid, g, b, r, ch):
