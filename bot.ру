def get_user(uid):
    r = c.execute('SELECT werx,diamonds,werk,rubins,stars,prestige,souls,love_points,love_level,last_daily,xp,level,sytana_wins,boss_wins,crystals,energy FROM users WHERE user_id=?', (uid,)).fetchone()
    if r: return r
    c.execute('INSERT INTO users (user_id, werx) VALUES (?,?)', (uid, 1000))
    conn.commit()
    return (1000,0,0,0,0,1,0,0,0,None,0,1,0,0,0,100)

def update_werx(uid, a): c.execute('UPDATE users SET werx = werx + ? WHERE user_id = ?', (a, uid)); conn.commit()
def update_diamonds(uid, a): c.execute('UPDATE users SET diamonds = diamonds + ? WHERE user_id = ?', (a, uid)); conn.commit()
def update_werk(uid, a): c.execute('UPDATE users SET werk = werk + ? WHERE user_id = ?', (a, uid)); conn.commit()
