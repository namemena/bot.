@dp.callback_query(lambda c: c.data and c.data.startswith('case_'))
async def open_case(call):
    cid = int(call.data.split('_')[1])
    uid = call.from_user.id
    case = c.execute('SELECT name,price,currency,rewards,chance FROM cases WHERE case_id=?', (cid,)).fetchone()
    if not case:
        return await call.answer("Ошибка!")
    name, price, cur, rew, ch = case
    rew = [int(x) for x in rew.split(',')]
    w,d,wk,r,s,p,souls,lp,ll,_,xp,lvl,sw,bw,cr,en = get_user(uid)
    bal = {'werx':w, 'diamonds':d, 'werk':wk, 'stars':s, 'souls':souls, 'love_points':lp}.get(cur, 0)
    if bal < price:
        return await call.answer(f"❌ Нужно {price}!", show_alert=True)
    updaters = {'werx':update_werx, 'diamonds':update_diamonds, 'werk':update_werk, 'stars':update_stars, 'souls':update_souls, 'love_points':update_love}
    updaters[cur](uid, -price)
    rare = random.randint(1, 100) <= ch
    rw = max(rew) if rare else random.choice(rew[:-1] if len(rew) > 1 else rew)
    rtxt = "🌟 РЕДКИЙ ПРЕДМЕТ! 🌟\n" if rare else ""
    if cur == 'love_points':
        lv, nl = update_love(uid, rw)
        restxt = f"+{rw}💗" + (f"\n🎉 УРОВЕНЬ {nl}!" if lv else "")
    else:
        updaters[cur](uid, rw)
        icons = {'werx':'⭐', 'diamonds':'💎', 'werk':'🔧', 'stars':'✨', 'souls':'👻'}
        restxt = f"+{rw}{icons.get(cur, '')}"
    await call.message.edit_text(f"🎁 {name}\n💰 -{price}\n{rtxt}{restxt}")
    await call.answer()

